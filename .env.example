SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
ADMIN_USER_IDS=YOUR_SUPABASE_AUTH_USER_UUID
UPLOAD_SIGNING_SECRET=REPLACE_WITH_RANDOM_64_CHARACTER_SECRET
# NFC digital cards: signs customer CSRF tokens and image-upload receipts. Server only, at least 32 characters,
# different from UPLOAD_SIGNING_SECRET. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NFC_SESSION_SECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_64_CHARACTER_SECRET
APP_ORIGIN=http://localhost:5175
PORT=5175
